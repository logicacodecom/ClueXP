{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules/**,.next/**,**/*.png,**/*.zip}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "api.cluexp.com" }],
      "destination": "/api/main"
    },
    { "source": "/v1/(.*)", "destination": "/api/main" },
    { "source": "/api/(.*)", "destination": "/api/main" }
  ],
  "crons": [
    { "path": "/api/cron/dispatch-sweep", "schedule": "0 8 * * *" }
  ]
}
