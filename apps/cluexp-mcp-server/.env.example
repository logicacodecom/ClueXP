# Placeholder-only ClueXP MCP configuration.
# Copy to your local shell/hosting secret manager; do not commit real values.

# Local/dev default for internal smoke. Production launch uses:
# CLUEXP_API_BASE_URL=https://api.cluexp.com
CLUEXP_API_BASE_URL=http://127.0.0.1:8000

# External ClueXP public API key with only the scopes needed by this MCP deployment:
# services:read, coverage:check, service_requests:write,
# service_requests:authorize, service_requests:read, service_requests:cancel
CLUEXP_API_KEY=replace-with-scoped-api-key

# Internal-preview fallback only. Production ChatGPT plugin traffic uses the
# OAuth settings below. Keep this value distinct from CLUEXP_API_KEY.
CLUEXP_MCP_BEARER_TOKEN=replace-with-random-remote-mcp-token

# OAuth 2.1 resource-server settings for the public ChatGPT plugin. The issuer
# is the Auth0 tenant or custom-domain origin. The resource URL is also used as
# the audience unless CLUEXP_MCP_OAUTH_AUDIENCE is set separately.
CLUEXP_MCP_OAUTH_ISSUER=https://replace-with-auth0-domain/
CLUEXP_MCP_OAUTH_RESOURCE_SERVER_URL=https://mcp.cluexp.com/mcp
CLUEXP_MCP_OAUTH_AUDIENCE=https://mcp.cluexp.com/mcp
CLUEXP_MCP_OAUTH_SCOPE=cluexp:use

# Optional override; Auth0's standard JWKS URL is derived from the issuer.
# CLUEXP_MCP_OAUTH_JWKS_URL=https://replace-with-auth0-domain/.well-known/jwks.json

# Exact Host header values accepted by the MCP SDK DNS-rebinding guard.
# The app also includes localhost, 127.0.0.1, testserver, mcp.cluexp.com,
# and Vercel's own VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL when present.
CLUEXP_MCP_ALLOWED_HOSTS=mcp.cluexp.com

# Optional exact token returned at /.well-known/openai-apps-challenge during
# OpenAI plugin domain verification. Leave unset until the submission portal
# provides the challenge token.
OPENAI_APPS_CHALLENGE_TOKEN=replace-only-when-openai-portal-requests-domain-verification
