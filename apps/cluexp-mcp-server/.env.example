# Placeholder-only ClueXP MCP configuration.
# Copy to your local shell/hosting secret manager; do not commit real values.

# Local/dev default for internal smoke. Production launch uses:
# CLUEXP_API_BASE_URL=https://api.cluexp.com
CLUEXP_API_BASE_URL=http://127.0.0.1:8000

# External ClueXP public API key with ONLY the two read scopes this server uses:
# services:read, providers:search
CLUEXP_API_KEY=replace-with-scoped-api-key

# The MCP endpoint itself is public (no sign-in, specs/003). Abuse is bounded by
# a Vercel Firewall rate-limit rule on /mcp and the /v1 key's own rate limit.

# Exact Host header values accepted by the MCP SDK DNS-rebinding guard.
# The app also includes localhost, 127.0.0.1, testserver, mcp.cluexp.com,
# and Vercel's own VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL when present.
CLUEXP_MCP_ALLOWED_HOSTS=mcp.cluexp.com

# Optional exact token returned at /.well-known/openai-apps-challenge during
# OpenAI plugin domain verification. Leave unset until the submission portal
# provides the challenge token.
OPENAI_APPS_CHALLENGE_TOKEN=replace-only-when-openai-portal-requests-domain-verification
