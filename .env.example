# Local Next.js -> FastAPI rewrite target.
LOCAL_API_BASE_URL=http://127.0.0.1:8000

# Production Supabase Postgres connection.
# For Vercel serverless Python, prefer Supabase transaction pooler on port 6543.
DATABASE_URL=postgres://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Supabase project URL + service role key for backend-only Storage signing.
# Never expose the service key to browser code.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# API CORS allowlist (comma-separated). Unset falls back to "*" for local dev.
ALLOWED_ORIGINS=https://your-project.vercel.app

# Frontend (NEXT_PUBLIC_*) — safe to expose to the browser.
# Demo banner on fulfillment/payment screens; set to "false" once those are real.
NEXT_PUBLIC_DEMO_MODE=true
# Number the human-handoff "Call now" button dials.
NEXT_PUBLIC_DISPATCH_PHONE=+18005551234

# Google Maps. Use separate keys with separate restrictions.
# Browser render key: Maps JavaScript API only, HTTP-referrer restricted.
NEXT_PUBLIC_MAPS_BROWSER_KEY=your_browser_maps_key
# Server credential key: Geocoding API + Routes API only, never exposed to client JS.
GOOGLE_MAPS_API_KEY=your_server_maps_key

# Provider SaaS subscription billing. Keep both switches false until the
# corresponding Product Owner production authorization is recorded.
PROVIDER_BILLING_ENABLED=false
PROVIDER_BILLING_ENFORCEMENT_ENABLED=false
# Server-only restricted Stripe key with Customers, Checkout Sessions,
# Billing Portal Sessions, and Subscriptions access. Never expose in Next.js.
STRIPE_BILLING_API_KEY=rk_test_replace_me
STRIPE_BILLING_WEBHOOK_SECRET=whsec_replace_me
# ClueXP Provider Access, $419/month, sandbox Price.
STRIPE_PROVIDER_PRICE_ID=price_1UUxmtQiiIMhyzQxb3AieWB8
# Pin the Dashboard configuration that permits payment-method/invoice access
# and end-of-period cancellation, with plan/quantity changes disabled.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
PROVIDER_BILLING_TRIAL_DAYS=30
PROVIDER_BILLING_GRACE_DAYS=7
CLUEXP_PROVIDER_BASE_URL=http://127.0.0.1:3002
